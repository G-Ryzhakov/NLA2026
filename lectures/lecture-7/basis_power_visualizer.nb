Notebook[{

Cell[CellGroupData[{
Cell["Matrix powers, eigenvectors, and QR", "Title",ExpressionUUID->"c1288c6e-3eb8-425e-b51d-f41ddcf15319"],

Cell["\<\
One 3D view of the three columns of A^k I. The eigenvector directions remain \
visible, and an optional QR overlay shows the columns of Q in A^k = Q R.\
\>", "Text",ExpressionUUID->"f9f18385-668f-45a9-a378-61286f06e999"],

Cell["\<\
Start: choose Evaluation > Evaluate Notebook. This notebook is \
self-contained. Edit the example cell to use your own directions and \
eigenvalues, then press Shift+Enter on that cell.\
\>", "Text",ExpressionUUID->"11dd1436-046d-40a5-85c7-a81feafffd72"],

Cell[CellGroupData[{

Cell["Implementation (evaluated automatically with the notebook)", "Section",ExpressionUUID->"698e6241-09c3-46ab-80d4-d64f9cec26eb"],

Cell[BoxData[
 RowBox[{"ToExpression", "[", 
  "\"\<(* Matrix powers, eigenbasis components, and QR -- English interface. \
*)\\nClearAll[\\n  basisPowerRealQ, basisPowerNumber, \
basisPowerMatrixView,\\n  basisPowerMakeData, basisPowerState, \
basisPowerComponents,\\n  basisPowerLabelPoint, basisPowerArrow, \
basisPowerAxes, basisPowerPlot, basisPowerPanel,\\n  \
basisPowerVisualizer\\n];\\n\\nbasisPowerRealQ[x_] := NumericQ[x] && \
TrueQ[Im[N[x]] == 0];\\n\\nbasisPowerNumber[x_] := Which[\\n  TrueQ[x == 0], \
0,\\n  10^-3 <= Abs[x] < 10^4, NumberForm[N[x, 8], {6, 3}],\\n  True, \
ScientificForm[N[x, 8], 3]\\n];\\n\\nbasisPowerMatrixView[m_] := Style[\\n  \
MatrixForm[Map[basisPowerNumber, m, {2}]], 11, FontFamily -> \
\\\"Arial\\\"\\n];\\n\\nbasisPowerMakeData::directions =\\n  \\\"Eigenvectors \
must be a real 3 x 3 matrix with three independent nonzero columns. Each \
column is normalized internally.\\\";\\nbasisPowerMakeData::values =\\n  \
\\\"Eigenvalues must be a list of three finite real numbers. This 3D \
visualization uses real eigenvectors and \
eigenvalues.\\\";\\nbasisPowerMakeData::iterations =\\n  \\\"MaxIterations \
must be a nonnegative integer.\\\";\\n\\nbasisPowerMakeData[directions_, \
values_, maxIterations_: 30] := Module[\\n  {raw, exactValues, s, inverse, a, \
nonzero, spread, precision,\\n   largest, bound, orthogonalQ},\\n  \
If[!MatrixQ[directions, basisPowerRealQ] ||\\n     Dimensions[directions] =!= \
{3, 3},\\n    Message[basisPowerMakeData::directions]; Return[$Failed]\\n  ];\
\\n  raw = Rationalize[directions, 0];\\n  If[TrueQ[Det[raw] == 0],\\n    \
Message[basisPowerMakeData::directions]; Return[$Failed]\\n  ];\\n  \
If[!VectorQ[values, basisPowerRealQ] || Length[values] =!= 3,\\n    \
Message[basisPowerMakeData::values]; Return[$Failed]\\n  ];\\n  \
If[!IntegerQ[maxIterations] || maxIterations < 0,\\n    \
Message[basisPowerMakeData::iterations]; Return[$Failed]\\n  ];\\n  \
exactValues = Rationalize[values, 0];\\n  nonzero = Select[Abs[exactValues], \
# > 0 &];\\n  spread = If[nonzero === {}, 0,\\n    Max[0, N[Log[10, \
Max[nonzero]/Min[nonzero]]]]\\n  ];\\n  (* Exactifying input floats fixes the \
specified numeric matrix first.\\n     Extra working precision preserves the \
small directions in A^k. *)\\n  precision = Max[70, 50 + \
Ceiling[maxIterations spread] +\\n    Ceiling[Max[0, N[Log[10, Norm[N[raw, \
30]] Norm[Inverse[N[raw, 30]]]]]]]];\\n  s = Transpose[Normalize /@ \
Transpose[N[raw, precision]]];\\n  inverse = Inverse[s];\\n  exactValues = \
N[exactValues, precision];\\n  a = s . DiagonalMatrix[exactValues] . inverse;\
\\n  orthogonalQ = TrueQ[Max[Abs[Flatten[Transpose[s].s - \
IdentityMatrix[3]]]] < 10^-25];\\n  largest = Max[Abs[exactValues]];\\n  \
bound = Max[1, Norm[s] Norm[inverse]];\\n  <|\\n    \\\"S\\\" -> s, \
\\\"InverseS\\\" -> inverse, \\\"Eigenvalues\\\" -> exactValues,\\n    \
\\\"A\\\" -> a, \\\"MaxIterations\\\" -> maxIterations,\\n    \
\\\"WorkingPrecision\\\" -> precision, \\\"OrthogonalQ\\\" -> orthogonalQ,\\n \
   \\\"ZoomLogMaximum\\\" -> Max[6, Ceiling[\\n      N[Log[10, bound]] + \
maxIterations Max[0, N[Log[10, Max[1, largest]]]]\\n    ] + 2]\\n  |>\\n];\\n\
\\nbasisPowerComponents[data_, k_Integer] := Module[{weights},\\n  weights = \
If[k == 0, {1, 1, 1}, data[\\\"Eigenvalues\\\"]^k];\\n  Table[\\n    \
weights[[j]] data[\\\"InverseS\\\"][[j, i]] data[\\\"S\\\"][[All, j]],\\n    \
{i, 3}, {j, 3}\\n  ]\\n];\\n\\nbasisPowerState[data_, k_Integer] := \
Module[\\n  {power, qRows, r, q, signs, scale, weights, n = Clip[k, {0, data[\
\\\"MaxIterations\\\"]}]},\\n  weights = If[n == 0, {1, 1, 1}, \
data[\\\"Eigenvalues\\\"]^n];\\n  power = If[n == 0, N[IdentityMatrix[3], \
data[\\\"WorkingPrecision\\\"]],\\n    data[\\\"S\\\"] . \
DiagonalMatrix[weights] . data[\\\"InverseS\\\"]\\n  ];\\n  scale = \
Max[Abs[Flatten[power]]];\\n  If[TrueQ[scale == 0],\\n    q = \
IdentityMatrix[3]; r = power,\\n    (* Mathematica returns row-oriented Q: \
Qrows . M == R.\\n       Therefore the column-oriented factor is \
Transpose[Qrows]. *)\\n    {qRows, r} = QRDecomposition[power/scale];\\n    q \
= Transpose[qRows]; r = scale r;\\n    signs = Table[If[TrueQ[r[[j, j]] < 0], \
-1, 1], {j, 3}];\\n    q = q . DiagonalMatrix[signs];\\n    r = \
DiagonalMatrix[signs] . r\\n  ];\\n  <|\\\"k\\\" -> n, \\\"Power\\\" -> \
power, \\\"Q\\\" -> q, \\\"R\\\" -> r|>\\n];\\n\\n(* All graphics coordinates \
are scaled before conversion to machine\\n   precision. This avoids overflow \
at large powers. Zoom rescales the\\n   scene independently of the camera, so \
rotating cannot disable it. *)\\nbasisPowerLabelPoint[point_, offset_] :=\\n  \
N[point + .0025 {offset[[1]], offset[[1]]/2, \
offset[[2]]}];\\n\\nbasisPowerArrow[vector_, radius_, color_, label_: \
None,\\n  opacity_: 1., thickness_: 2.5, head_: .013, offset_: {10, 8}] := \
Module[\\n  {extent, factor, tip, clipped, labelObject},\\n  extent = \
Max[Abs[vector]];\\n  If[TrueQ[extent == 0] || TrueQ[extent/radius < 10^-6], \
Return[{}]];\\n  factor = Min[1, .82 radius/extent];\\n  tip = \
N[(factor/radius) vector];\\n  clipped = TrueQ[factor < 1];\\n  labelObject = \
If[label === None, {},\\n    Text[\\n      Style[If[clipped, Row[{label, \\\" \
(outside view)\\\"}], label],\\n        12, color, Background -> White],\\n   \
   basisPowerLabelPoint[tip, offset], {-1, 0}\\n    ]\\n  ];\\n  {\\n    \
Directive[color, Opacity[opacity], AbsoluteDashing[None], \
AbsoluteThickness[thickness]],\\n    If[clipped,\\n      {Line[{{0., 0., 0.}, \
tip}], PointSize[.006], Point[tip]},\\n      {Arrowheads[head], Arrow[{{0., \
0., 0.}, tip}]}\\n    ],\\n    labelObject\\n  \
}\\n];\\n\\nbasisPowerAxes[radius_] := Module[{step, ticks, objects, point, \
other},\\n  step = 10^Floor[Log[10, radius]];\\n  If[step/radius > .65, step \
= step/2];\\n  ticks = Select[Range[-4, 4] step, # != 0 && Abs[#] < .79 \
radius &];\\n  objects = Table[\\n    {\\n      Directive[GrayLevel[.8], \
AbsoluteDashing[None], AbsoluteThickness[.8]],\\n      Line[{-.89 \
UnitVector[3, j], .89 UnitVector[3, j]}],\\n      Text[Style[{\\\"x\\\", \
\\\"y\\\", \\\"z\\\"}[[j]], 12, GrayLevel[.48]], .94 UnitVector[3, j]],\\n    \
  Table[\\n        point = N[t/radius] UnitVector[3, j];\\n        other = \
UnitVector[3, If[j == 3, 1, 3]];\\n        {\\n          Line[{point - .008 \
other, point + .008 other}],\\n          Text[Style[basisPowerNumber[t], 9, \
GrayLevel[.57]],\\n            basisPowerLabelPoint[point, If[j == 3, {-14, \
0}, {0, -12}]]]\\n        },\\n        {t, ticks}\\n      ]\\n    }, {j, \
3}\\n  ];\\n  {objects, GrayLevel[.45], PointSize[.004], Point[{0., 0., 0.}]}\
\\n];\\n\\nbasisPowerPlot[data_, state_, visible_, showQR_, componentChoice_, \
zoomLog_,\\n  cameraPoint_, cameraVertical_, cameraAngle_, imageSize_: 850] \
:= Module[\\n  {colors, qColor, s, columns, components, active, relevant, \
baseRadius,\\n   radius, eigGuides, componentObjects, vectorObjects, \
qObjects,\\n   selected, direction, k, componentLabels, labelOffsets},\\n  \
colors = {RGBColor[.12, .36, .86], RGBColor[.87, .39, .10], RGBColor[.05, \
.56, .39]};\\n  qColor = RGBColor[.56, .17, .69];\\n  s = data[\\\"S\\\"]; k \
= state[\\\"k\\\"];\\n  columns = Transpose[state[\\\"Power\\\"]];\\n  \
components = basisPowerComponents[data, k];\\n  active = Select[Range[3], \
TrueQ[visible[[#]]] &];\\n  selected = Which[\\n    componentChoice == 0, {},\
\\n    componentChoice == 4, active,\\n    MemberQ[active, componentChoice], \
{componentChoice},\\n    True, {}\\n  ];\\n  relevant = Join[{{1, 1, 1}}, \
columns[[active]], Flatten[components[[selected]], 1]];\\n  baseRadius = 1.4 \
Max[Abs[Flatten[relevant]]];\\n  radius = baseRadius/10^SetPrecision[zoomLog, \
30];\\n  labelOffsets = {{10, 12}, {10, -13}, {10, 30}};\\n  eigGuides = \
Table[\\n    direction = N[s[[All, j]]];\\n    {\\n      \
Directive[GrayLevel[.56], Opacity[.55], AbsoluteThickness[1.2], \
AbsoluteDashing[None]],\\n      Line[{-.83 direction/Max[Abs[direction]], .83 \
direction/Max[Abs[direction]]}],\\n      Text[Style[Row[{Subscript[\\\"v\\\", \
j], \\\" direction\\\"}], 11, GrayLevel[.32], Background -> White],\\n        \
basisPowerLabelPoint[.77 direction/Max[Abs[direction]], {-10, -7 - 12 (j - \
1)}], {1, 0}],\\n      basisPowerArrow[s[[All, j]], radius, GrayLevel[.3],\\n \
       If[.03 < 1/radius < 1, Subscript[\\\"v\\\", j], None], .9, 1.8, .011, \
{-14, 10}]\\n    }, {j, 3}\\n  ];\\n  componentLabels = Length[selected] == \
1;\\n  componentObjects = Table[\\n    Table[\\n      {\\n        \
basisPowerArrow[components[[i, j]], radius, colors[[i]],\\n          \
If[componentLabels, Row[{\\\"component \\\", j}], None],\\n          .40, \
1.5, .009, {8, -18 - 11 j}],\\n        If[componentLabels,\\n          \
Module[{p = components[[i, j]], w = columns[[i]], ext},\\n            ext = \
Max[Abs[Flatten[{p, w}]]];\\n            If[TrueQ[ext/radius < .8],\\n        \
      {Directive[colors[[i]], Opacity[.18], AbsoluteThickness[1], \
AbsoluteDashing[None]],\\n               Line[N[{p, w}/radius]]}, {}]\\n      \
    ], {}]\\n      }, {j, 3}], {i, selected}\\n  ];\\n  vectorObjects = \
Table[\\n    basisPowerArrow[columns[[i]], radius, colors[[i]],\\n      \
Row[{Superscript[\\\"A\\\", k], \\\" \\\", Subscript[\\\"e\\\", i]}],\\n      \
1., 3., .014, labelOffsets[[i]]], {i, active}\\n  ];\\n  qObjects = \
If[TrueQ[showQR],\\n    Table[basisPowerArrow[state[\\\"Q\\\"][[All, i]], \
radius, qColor,\\n      Subscript[\\\"q\\\", i], .95, 2.3, .012, {-48, -14 + \
19 i}], {i, 3}], {}\\n  ];\\n  Graphics3D[\\n    {basisPowerAxes[radius], \
eigGuides, componentObjects, vectorObjects, qObjects},\\n    Axes -> False, \
Boxed -> False,\\n    PlotRange -> ConstantArray[{-1., 1.}, 3], \
PlotRangePadding -> None,\\n    ImagePadding -> {{35, 65}, {30, 25}},\\n    \
ViewCenter -> {1/2, 1/2, 1/2}, ViewPoint -> cameraPoint,\\n    ViewVertical \
-> cameraVertical, ViewAngle -> cameraAngle,\\n    ViewProjection -> \
\\\"Perspective\\\", SphericalRegion -> False,\\n    Lighting -> \
\\\"Neutral\\\", Background -> White,\\n    ImageSize -> {imageSize, \
Round[.77 imageSize]},\\n    PlotLabel -> Style[Row[{Superscript[\\\"A\\\", \
k], \\\" I: columns \\\",\\n      Superscript[\\\"A\\\", k], \\\" \\\", \
Subscript[\\\"e\\\", \\\"i\\\"],\\n      \\\"     |     zoom = \\\", \
basisPowerNumber[10^SetPrecision[zoomLog, 30]], \\\"x\\\"}], 14, Bold]\\n  \
]\\n];\\n\\nbasisPowerPanel[data_, state_, showQR_] := Column[\\n  {\\n    \
Style[Row[{Superscript[\\\"A\\\", state[\\\"k\\\"]], \\\" = S diag(\\\",\\n   \
   Subscript[\\\"lambda\\\", 1], \\\"^k, \\\", Subscript[\\\"lambda\\\", 2], \
\\\"^k, \\\",\\n      Subscript[\\\"lambda\\\", 3], \\\"^k) \\\", \
Superscript[\\\"S\\\", \\\"-1\\\"]}], 12],\\n    Grid[\\n      \
If[TrueQ[showQR],\\n        {{Style[Row[{Superscript[\\\"A\\\", state[\\\"k\\\
\"]], \\\" = Q R\\\"}], Bold],\\n          \
basisPowerMatrixView[state[\\\"Power\\\"]], \\\"=\\\", \
basisPowerMatrixView[state[\\\"Q\\\"]],\\n          \
basisPowerMatrixView[state[\\\"R\\\"]]}},\\n        {{Style[Superscript[\\\"A\
\\\", state[\\\"k\\\"]], Bold], \
basisPowerMatrixView[state[\\\"Power\\\"]]}}\\n      ], Alignment -> Center, \
Spacings -> {1, .5}\\n    ],\\n    If[TrueQ[showQR],\\n      Style[\\\"Q \
columns are unit and mutually perpendicular. Use Unit scale to see them at \
large k.\\\", 11, GrayLevel[.35]],\\n      Nothing]\\n  }, Alignment -> \
Center, Spacings -> .6\\n];\\n\\nOptions[basisPowerVisualizer] = {\\n  \
\\\"Eigenvectors\\\" -> Transpose[{{2, 1, 2}, {-2, 2, 1}, {-1, -2, 2}}],\\n  \
\\\"Eigenvalues\\\" -> {2, 5/4, 1/2}, \\\"MaxIterations\\\" -> 30,\\n  \
\\\"Iteration\\\" -> 0, \\\"Zoom\\\" -> 1., \\\"ImageSize\\\" -> 850,\\n  \
\\\"ShowQR\\\" -> False, \\\"Components\\\" -> \
4\\n};\\n\\nbasisPowerVisualizer[OptionsPattern[]] := Module[\\n  {data, k0, \
zoom0, imageSize, qr0, components0},\\n  data = \
basisPowerMakeData[OptionValue[\\\"Eigenvectors\\\"],\\n    \
OptionValue[\\\"Eigenvalues\\\"], OptionValue[\\\"MaxIterations\\\"]];\\n  \
If[data === $Failed, Return[$Failed]];\\n  k0 = \
Clip[Round[OptionValue[\\\"Iteration\\\"]], {0, \
data[\\\"MaxIterations\\\"]}];\\n  zoom0 = Clip[N[Log[10, Max[10^-3, \
OptionValue[\\\"Zoom\\\"]]]], {-3., data[\\\"ZoomLogMaximum\\\"]}];\\n  \
imageSize = OptionValue[\\\"ImageSize\\\"]; qr0 = \
TrueQ[OptionValue[\\\"ShowQR\\\"]];\\n  components0 = \
OptionValue[\\\"Components\\\"];\\n  With[{model = data, imageWidth = \
imageSize},\\n    DynamicModule[\\n      {iteration = k0, zoomLog = zoom0, \
visible = {True, True, True},\\n       showQR = qr0, componentChoice = \
components0,\\n       cameraPoint = {2.5, -3.4, 2.2}, cameraVertical = {0., \
0., 1.},\\n       cameraAngle = 10 Degree},\\n      Column[\\n        {\\n    \
      Style[\\\"Matrix powers in an eigenbasis\\\", 21, Bold, \
GrayLevel[.18]],\\n          Style[\\\"A = S diag(lambda) S^-1; the columns \
of S are unit eigenvectors.\\\", 12],\\n          Grid[{{Style[\\\"A\\\", \
Bold], basisPowerMatrixView[model[\\\"A\\\"]],\\n                 Style[\\\"S\
\\\", Bold], basisPowerMatrixView[model[\\\"S\\\"]],\\n                 \
Style[\\\"lambda\\\", Bold], \
basisPowerMatrixView[Transpose[{model[\\\"Eigenvalues\\\"]}]]}},\\n           \
 Spacings -> {1.1, .6}, Alignment -> Center],\\n          \
Style[If[model[\\\"OrthogonalQ\\\"],\\n            \\\"The input directions \
are normalized. Here S is orthogonal: the eigenbasis components are \
orthogonal projections.\\\",\\n            \\\"The input directions are \
normalized but not orthogonal. Components use S^-1 e_i; they are not \
perpendicular projections.\\\"],\\n            11, GrayLevel[.32]],\\n        \
  Grid[\\n            {\\n              {Style[\\\"Iteration k\\\", Bold], \
Slider[Dynamic[iteration,\\n                  Function[value, iteration = \
Clip[Round[value], {0, model[\\\"MaxIterations\\\"]}]]],\\n                \
{0, model[\\\"MaxIterations\\\"], 1}, ImageSize -> 380], \
Dynamic[Round[iteration]]},\\n              {Style[\\\"Zoom in / out\\\", \
Bold], Slider[Dynamic[zoomLog],\\n                {-3., \
model[\\\"ZoomLogMaximum\\\"], .02}, ImageSize -> 380],\\n                \
Dynamic[Row[{basisPowerNumber[10^SetPrecision[zoomLog, 30]], \\\"x\\\"}]]}\\n \
           }, Alignment -> Left, Spacings -> {1.2, .7}\\n          ],\\n      \
    Row[{\\n            Checkbox[Dynamic[visible[[1]]]], Style[\\\" A^k e1    \
\\\", RGBColor[.12, .36, .86], Bold],\\n            \
Checkbox[Dynamic[visible[[2]]]], Style[\\\" A^k e2    \\\", RGBColor[.87, \
.39, .10], Bold],\\n            Checkbox[Dynamic[visible[[3]]]], Style[\\\" \
A^k e3        \\\", RGBColor[.05, .56, .39], Bold],\\n            \
Checkbox[Dynamic[showQR]], Style[\\\" Show Q in A^k = Q R\\\", RGBColor[.56, \
.17, .69], Bold]\\n          }],\\n          Row[{\\\"Eigenbasis components: \
\\\",\\n            PopupMenu[Dynamic[componentChoice], {0 -> \\\"Off\\\", 1 \
-> \\\"e1 only\\\", 2 -> \\\"e2 only\\\", 3 -> \\\"e3 only\\\", 4 -> \\\"All \
visible vectors\\\"}],\\n            Spacer[20], Button[\\\"Fit vectors\\\", \
zoomLog = 0.], Spacer[8],\\n            Button[\\\"Unit scale\\\", \
Module[{st, active, vectors, parts, selected, rad},\\n              st = \
basisPowerState[model, Round[iteration]];\\n              active = \
Select[Range[3], TrueQ[visible[[#]]] &];\\n              parts = \
basisPowerComponents[model, Round[iteration]];\\n              selected = \
Which[componentChoice == 4, active,\\n                MemberQ[active, \
componentChoice], {componentChoice}, True, {}];\\n              vectors = \
Join[{{1, 1, 1}}, Transpose[st[\\\"Power\\\"]][[active]], \
Flatten[parts[[selected]], 1]];\\n              rad = 1.4 \
Max[Abs[Flatten[vectors]]];\\n              zoomLog = N[Log[10, rad/1.4]]\\n  \
          ]], Spacer[8],\\n            Button[\\\"Reset rotation\\\", \
cameraPoint = {2.5, -3.4, 2.2};\\n              cameraVertical = {0., 0., \
1.}; cameraAngle = 10 Degree]\\n          }],\\n          Dynamic[\\n         \
   basisPowerPlot[model, basisPowerState[model, Round[iteration]],\\n         \
     visible, showQR, componentChoice, zoomLog,\\n              \
Dynamic[cameraPoint, Function[value, cameraPoint = value]],\\n              \
Dynamic[cameraVertical, Function[value, cameraVertical = value]],\\n          \
    Dynamic[cameraAngle, Function[value, cameraAngle = value]], \
imageWidth],\\n            TrackedSymbols :> {iteration, visible, showQR, \
componentChoice, zoomLog}\\n          ],\\n          Style[\\\"Grey lines \
keep the eigenvector directions visible at every scale; their unit arrows \
have fixed mathematical length. Pale colored arrows are eigenbasis \
components. Purple arrows are the Q columns. A line ending in a dot with \
'outside view' has been clipped, not shortened mathematically.\\\",\\n        \
    11, GrayLevel[.35]],\\n          Style[Row[{\\\"At k = 0: \\\", \
Subscript[\\\"e\\\", \\\"i\\\"], \\\" = sum_j \\\", Subscript[\\\"c\\\", \
\\\"ji\\\"], \\\" \\\",\\n            Subscript[\\\"v\\\", \\\"j\\\"], \\\".  \
At iteration k: \\\", Superscript[\\\"A\\\", \\\"k\\\"], \\\" \\\", \
Subscript[\\\"e\\\", \\\"i\\\"],\\n            \\\" = sum_j \\\", \
Subscript[\\\"c\\\", \\\"ji\\\"], \\\" \\\", Superscript[Subscript[\\\"lambda\
\\\", \\\"j\\\"], \\\"k\\\"],\\n            \\\" \\\", Subscript[\\\"v\\\", \
\\\"j\\\"], \\\", where C = \\\", Superscript[\\\"S\\\", \\\"-1\\\"], \\\".\\\
\"}], 12],\\n          Dynamic[basisPowerPanel[model, basisPowerState[model, \
Round[iteration]], showQR],\\n            TrackedSymbols :> {iteration, \
showQR}]\\n        }, Alignment -> Center, Spacings -> 1.\\n      ],\\n      \
SaveDefinitions -> True,\\n      BaseStyle -> {FontFamily -> \\\"Arial\\\", \
FontSize -> 12}\\n    ]\\n  ]\\n];\>\"", ",", "InputForm", "]"}]], "Input",
 InitializationCell->True,
 CellLabel->"In[73]:=",ExpressionUUID->"9d5c6ab7-ffc4-44a4-9411-48db0006a35e"]
}, Closed]],

Cell[CellGroupData[{

Cell["Choose the matrix", "Section",ExpressionUUID->"f29c7d5e-52ca-4326-aa1e-20bb17bf2c20"],

Cell["\<\
v1, v2, v3 are column directions, in the same order as the eigenvalues. Their \
lengths do not matter: each is normalized internally. They must be real, \
nonzero, and linearly independent. A is constructed as S . \
DiagonalMatrix[eigenvalues] . Inverse[S].\
\>", "Text",ExpressionUUID->"6d102023-5570-43b3-aeb4-4c71d0ab5b73"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"v1", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "1", ",", "2"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v2", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "3"}], ",", "2", ",", "1"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"v3", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "1"}], ",", 
     RowBox[{"-", "2"}], ",", "2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigenvectorMatrix", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"v1", ",", "v2", ",", "v3"}], "}"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"eigenvectorMatrix", " ", ".", " ", 
  RowBox[{"Transpose", "@", "eigenvectorMatrix"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eigenvalues", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", 
     FractionBox["5", "4"], ",", 
     FractionBox["1", "2"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"basisPowerVisualizer", "[", 
  RowBox[{
   RowBox[{"\"\<Eigenvectors\>\"", "\[Rule]", "eigenvectorMatrix"}], ",", 
   RowBox[{"\"\<Eigenvalues\>\"", "\[Rule]", "eigenvalues"}], ",", 
   RowBox[{"\"\<MaxIterations\>\"", "\[Rule]", "40"}], ",", 
   RowBox[{"\"\<ImageSize\>\"", "\[Rule]", "850"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.004075177726391*^9, 4.004075183405159*^9}, {
  4.004084213632139*^9, 4.004084214047866*^9}},
 CellLabel->"In[87]:=",ExpressionUUID->"bbd211c3-727d-4648-92d6-0f84a186c1b5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"14", ",", 
     RowBox[{"-", "2"}], ",", 
     RowBox[{"-", "1"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "2"}], ",", "9", ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
