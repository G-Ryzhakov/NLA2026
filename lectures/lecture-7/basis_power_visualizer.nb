$CellContext`q = 
         Transpose[$CellContext`qRows]; $CellContext`r = $CellContext`scale \
$CellContext`r; $CellContext`signs = Table[
           If[
            TrueQ[
            Part[$CellContext`r, $CellContext`j, $CellContext`j] < 0], -1, 
            1], {$CellContext`j, 3}]; $CellContext`q = Dot[$CellContext`q, 
