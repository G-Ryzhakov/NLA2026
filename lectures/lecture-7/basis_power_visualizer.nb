        Part[
          $CellContext`data["S"], All, $CellContext`j], {$CellContext`i, 
         3}, {$CellContext`j, 3}]], $CellContext`basisPowerPlot[
      Pattern[$CellContext`data, 
       Blank[]], 
      Pattern[$CellContext`state, 
       Blank[]], 
      Pattern[$CellContext`visible, 
       Blank[]], 
      Pattern[$CellContext`showQR, 
       Blank[]], 
      Pattern[$CellContext`componentChoice, 
       Blank[]], 
      Pattern[$CellContext`zoomLog, 
       Blank[]], 
      Pattern[$CellContext`cameraPoint, 
       Blank[]], 
      Pattern[$CellContext`cameraVertical, 
       Blank[]], 
      Pattern[$CellContext`cameraAngle, 
       Blank[]], 
      Optional[
       Pattern[$CellContext`imageSize, 
        Blank[]], 850]] := 
    Module[{$CellContext`colors, $CellContext`qColor, $CellContext`s, \
$CellContext`columns, $CellContext`components, $CellContext`active, \
$CellContext`relevant, $CellContext`baseRadius, $CellContext`radius, \
$CellContext`eigGuides, $CellContext`componentObjects, \
$CellContext`vectorObjects, $CellContext`qObjects, $CellContext`selected, \
$CellContext`direction, $CellContext`k, $CellContext`componentLabels, \
$CellContext`labelOffsets}, $CellContext`colors = {
         RGBColor[0.12, 0.36, 0.86], 
         RGBColor[0.87, 0.39, 0.1], 
         RGBColor[0.05, 0.56, 0.39]}; $CellContext`qColor = 
       RGBColor[0.56, 0.17, 0.69]; $CellContext`s = $CellContext`data[
        "S"]; $CellContext`k = $CellContext`state["k"]; $CellContext`columns = 
       Transpose[
         $CellContext`state[
         "Power"]]; $CellContext`components = \
$CellContext`basisPowerComponents[$CellContext`data, $CellContext`k]; \
$CellContext`active = Select[
         Range[3], TrueQ[
          Part[$CellContext`visible, #]]& ]; $CellContext`selected = 
       Which[$CellContext`componentChoice == 
         0, {}, $CellContext`componentChoice == 4, $CellContext`active, 
         MemberQ[$CellContext`active, $CellContext`componentChoice], \
{$CellContext`componentChoice}, True, {}]; $CellContext`relevant = 
       Join[{{1, 1, 1}}, 
         Part[$CellContext`columns, $CellContext`active], 
         Flatten[
          Part[$CellContext`components, $CellContext`selected], 
          1]]; $CellContext`baseRadius = 1.4 Max[
          Abs[
           
           Flatten[$CellContext`relevant]]]; $CellContext`radius = \
$CellContext`baseRadius/10^
        SetPrecision[$CellContext`zoomLog, 30]; $CellContext`labelOffsets = {{
        10, 12}, {10, -13}, {10, 30}}; $CellContext`eigGuides = 
       Table[$CellContext`direction = N[
            Part[$CellContext`s, All, $CellContext`j]]; {
           Directive[
            GrayLevel[0.56], 
            Opacity[0.55], 
            AbsoluteThickness[1.2], 
            AbsoluteDashing[None]], 
           Line[{(-0.83) ($CellContext`direction/Max[
               Abs[$CellContext`direction]]), 0.83 ($CellContext`direction/Max[
               Abs[$CellContext`direction]])}], 
           Text[
            Style[
             Row[{
               Subscript["v", $CellContext`j], " direction"}], 11, 
             GrayLevel[0.32], Background -> White], 
            $CellContext`basisPowerLabelPoint[0.77 ($CellContext`direction/Max[
               Abs[$CellContext`direction]]), {-10, -7 - 
              12 ($CellContext`j - 1)}], {1, 0}], 
           $CellContext`basisPowerArrow[
            Part[$CellContext`s, All, $CellContext`j], $CellContext`radius, 
            GrayLevel[0.3], 
            If[0.03 < 1/$CellContext`radius < 1, 
             Subscript["v", $CellContext`j], None], 0.9, 1.8, 0.011, {-14, 
            10}]}, {$CellContext`j, 3}]; $CellContext`componentLabels = 
       Length[$CellContext`selected] == 1; $CellContext`componentObjects = 
       Table[
         Table[{
           $CellContext`basisPowerArrow[
            
            Part[$CellContext`components, $CellContext`i, $CellContext`j], \
$CellContext`radius, 
            Part[$CellContext`colors, $CellContext`i], 
            If[$CellContext`componentLabels, 
             Row[{"component ", $CellContext`j}], None], 0.4, 1.5, 0.009, {
            8, -18 - 11 $CellContext`j}], 
           If[$CellContext`componentLabels, 
            
            Module[{$CellContext`p = 
              Part[$CellContext`components, $CellContext`i, $CellContext`j], \
$CellContext`w = 
              Part[$CellContext`columns, $CellContext`i], $CellContext`ext}, \
$CellContext`ext = Max[
                Abs[
                 Flatten[{$CellContext`p, $CellContext`w}]]]; If[
               TrueQ[$CellContext`ext/$CellContext`radius < 0.8], {
                Directive[
                 Part[$CellContext`colors, $CellContext`i], 
                 Opacity[0.18], 
                 AbsoluteThickness[1], 
                 AbsoluteDashing[None]], 
                Line[
                 
                 N[{$CellContext`p, $CellContext`w}/$CellContext`radius]]}, \
{}]], {}]}, {$CellContext`j, 
           3}], {$CellContext`i, $CellContext`selected}]; \
$CellContext`vectorObjects = Table[
         $CellContext`basisPowerArrow[
          Part[$CellContext`columns, $CellContext`i], $CellContext`radius, 
          Part[$CellContext`colors, $CellContext`i], 
          Row[{
            Superscript["A", $CellContext`k], " ", 
            Subscript["e", $CellContext`i]}], 1., 3., 0.014, 
          
          Part[$CellContext`labelOffsets, $CellContext`i]], {$CellContext`i, \
$CellContext`active}]; $CellContext`qObjects = If[
         TrueQ[$CellContext`showQR], 
         Table[
          $CellContext`basisPowerArrow[
           Part[
            $CellContext`state["Q"], 
            All, $CellContext`i], $CellContext`radius, $CellContext`qColor, 
           Subscript["q", $CellContext`i], 0.95, 2.3, 
           0.012, {-48, -14 + 19 $CellContext`i}], {$CellContext`i, 3}], {}]; 
      Graphics3D[{
         $CellContext`basisPowerAxes[$CellContext`radius], \
$CellContext`eigGuides, $CellContext`componentObjects, \
$CellContext`vectorObjects, $CellContext`qObjects}, Axes -> False, Boxed -> 
        False, PlotRange -> ConstantArray[{-1., 1.}, 3], PlotRangePadding -> 
        None, ImagePadding -> {{35, 65}, {30, 25}}, 
        ViewCenter -> {1/2, 1/2, 1/2}, ViewPoint -> $CellContext`cameraPoint, 
        ViewVertical -> $CellContext`cameraVertical, 
        ViewAngle -> $CellContext`cameraAngle, ViewProjection -> 
        "Perspective", SphericalRegion -> False, Lighting -> "Neutral", 
        Background -> White, ImageSize -> {$CellContext`imageSize, 
          Round[0.77 $CellContext`imageSize]}, PlotLabel -> Style[
          Row[{
            Superscript["A", $CellContext`k], " I: columns ", 
            Superscript["A", $CellContext`k], " ", 
            Subscript["e", "i"], "     |     zoom = ", 
            $CellContext`basisPowerNumber[
            10^SetPrecision[$CellContext`zoomLog, 30]], "x"}], 14, 
          Bold]]], $CellContext`basisPowerLabelPoint[
      Pattern[$CellContext`point, 
       Blank[]], 
      Pattern[$CellContext`offset, 
       Blank[]]] := N[$CellContext`point + 0.0025 {
         Part[$CellContext`offset, 1], Part[$CellContext`offset, 1]/2, 
         Part[$CellContext`offset, 2]}], $CellContext`basisPowerArrow[
      Pattern[$CellContext`vector, 
       Blank[]], 
      Pattern[$CellContext`radius, 
       Blank[]], 
      Pattern[$CellContext`color, 
       Blank[]], 
      Optional[
       Pattern[$CellContext`label, 
        Blank[]], None], 
      Optional[
       Pattern[$CellContext`opacity, 
        Blank[]], 1.], 
      Optional[
       Pattern[$CellContext`thickness, 
        Blank[]], 2.5], 
      Optional[
       Pattern[$CellContext`head, 
        Blank[]], 0.013], 
      Optional[
       Pattern[$CellContext`offset, 
        Blank[]], {10, 8}]] := 
    Module[{$CellContext`extent, $CellContext`factor, $CellContext`tip, \
$CellContext`clipped, $CellContext`labelObject}, $CellContext`extent = Max[
         Abs[$CellContext`vector]]; If[
        Or[
         TrueQ[$CellContext`extent == 0], 
         TrueQ[$CellContext`extent/$CellContext`radius < 10^(-6)]], 
        Return[{}]]; $CellContext`factor = 
       Min[1, 0.82 ($CellContext`radius/$CellContext`extent)]; \
$CellContext`tip = 
       N[($CellContext`factor/$CellContext`radius) $CellContext`vector]; \
$CellContext`clipped = 
       TrueQ[$CellContext`factor < 1]; $CellContext`labelObject = 
       If[$CellContext`label === None, {}, 
         Text[
          Style[
           If[$CellContext`clipped, 
            Row[{$CellContext`label, " (outside view)"}], $CellContext`label],
            12, $CellContext`color, Background -> White], 
          $CellContext`basisPowerLabelPoint[$CellContext`tip, \
$CellContext`offset], {-1, 0}]]; {
        Directive[$CellContext`color, 
         Opacity[$CellContext`opacity], 
         AbsoluteDashing[None], 
         AbsoluteThickness[$CellContext`thickness]], 
        If[$CellContext`clipped, {
          Line[{{0., 0., 0.}, $CellContext`tip}], 
          PointSize[0.006], 
          Point[$CellContext`tip]}, {
          Arrowheads[$CellContext`head], 
          
          Arrow[{{0., 0., 
            0.}, $CellContext`tip}]}], $CellContext`labelObject}], \
$CellContext`basisPowerAxes[
      Pattern[$CellContext`radius, 
       Blank[]]] := 
    Module[{$CellContext`step, $CellContext`ticks, $CellContext`objects, \
$CellContext`point, $CellContext`other}, $CellContext`step = 10^Floor[
          Log[10, $CellContext`radius]]; 
      If[$CellContext`step/$CellContext`radius > 
        0.65, $CellContext`step = $CellContext`step/2]; $CellContext`ticks = 
       Select[Range[-4, 4] $CellContext`step, 
         And[# != 0, Abs[#] < 
          0.79 $CellContext`radius]& ]; $CellContext`objects = Table[{
          Directive[
           GrayLevel[0.8], 
           AbsoluteDashing[None], 
           AbsoluteThickness[0.8]], 
          
          Line[{(-0.89) UnitVector[3, $CellContext`j], 0.89 
            UnitVector[3, $CellContext`j]}], 
          Text[
           Style[
            Part[{"x", "y", "z"}, $CellContext`j], 12, 
            GrayLevel[0.48]], 0.94 UnitVector[3, $CellContext`j]], 
          
          Table[$CellContext`point = 
            N[$CellContext`t/$CellContext`radius] 
             UnitVector[3, $CellContext`j]; $CellContext`other = UnitVector[3, 
              If[$CellContext`j == 3, 1, 3]]; {
             
             Line[{$CellContext`point - 
               0.008 $CellContext`other, $CellContext`point + 
               0.008 $CellContext`other}], 
             Text[
              Style[
               $CellContext`basisPowerNumber[$CellContext`t], 9, 
               GrayLevel[0.57]], 
              $CellContext`basisPowerLabelPoint[$CellContext`point, 
               
               If[$CellContext`j == 3, {-14, 0}, {
                0, -12}]]]}, {$CellContext`t, $CellContext`ticks}]}, \
{$CellContext`j, 3}]; {$CellContext`objects, 
        GrayLevel[0.45], 
        PointSize[0.004], 
        Point[{0., 0., 0.}]}], $CellContext`basisPowerPanel[
      Pattern[$CellContext`data, 
       Blank[]], 
      Pattern[$CellContext`state, 
       Blank[]], 
      Pattern[$CellContext`showQR, 
       Blank[]]] := Column[{
       Style[
        Row[{
          Superscript["A", 
           $CellContext`state["k"]], " = S diag(", 
          Subscript["lambda", 1], "^k, ", 
          Subscript["lambda", 2], "^k, ", 
          Subscript["lambda", 3], "^k) ", 
          Superscript["S", "-1"]}], 12], 
       Grid[
        If[
         TrueQ[$CellContext`showQR], {{
           Style[
            Row[{
              Superscript["A", 
               $CellContext`state["k"]], " = Q R"}], Bold], 
           $CellContext`basisPowerMatrixView[
            $CellContext`state["Power"]], "=", 
           $CellContext`basisPowerMatrixView[
            $CellContext`state["Q"]], 
           $CellContext`basisPowerMatrixView[
            $CellContext`state["R"]]}}, {{
           Style[
            Superscript["A", 
             $CellContext`state["k"]], Bold], 
           $CellContext`basisPowerMatrixView[
            $CellContext`state["Power"]]}}], Alignment -> Center, 
        Spacings -> {1, 0.5}], 
       If[
        TrueQ[$CellContext`showQR], 
        Style[
        "Q columns are unit and mutually perpendicular. Use Unit scale to see \
them at large k.", 11, 
         GrayLevel[0.35]], Nothing]}, Alignment -> Center, Spacings -> 
      0.6], $CellContext`basisPowerMatrixView[
      Pattern[$CellContext`m, 
       Blank[]]] := Style[
      MatrixForm[
       Map[$CellContext`basisPowerNumber, $CellContext`m, {2}]], 11, 
      FontFamily -> "Arial"]}]], "Output",
 CellChangeTimes->{{4.004044232496665*^9, 4.004044254499251*^9}, {
   4.004044363732986*^9, 4.004044382399457*^9}, 4.004044545032036*^9, {
   4.004044620465535*^9, 4.0040446304155912`*^9}, {4.004075093295575*^9, 
